# Supabase (Project settings > API)
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the site (used in payment return URLs and e-mails)
BOOKIFY_URL=http://localhost:3000

# Payments: choose one gateway. Leave blank to show "payments not configured".
PAYMENT_GATEWAY=sslcommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SUPPORT_EMAIL=
CRON_SECRET=

# Simulation clock speed for fleet movement: 1 is real time, 60 makes one real second a simulated minute.
# Defaults to 60 when running npm run dev; set 1 for real time.
NEXT_PUBLIC_SIM_SPEED=60
