# Supabase (Project settings > API)
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the site (used in payment return URLs and e-mails)
BOOKIFY_URL=http://localhost:3000

# Payments: choose one gateway. Leave blank to show "payments not configured".
PAYMENT_GATEWAY=sslcommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SUPPORT_EMAIL=
CRON_SECRET=

# Simulation clock speed for fleet movement: 1 is real time, 60 makes one real second a simulated minute.
# Defaults to 60 when running npm run dev; set 1 for real time.
NEXT_PUBLIC_SIM_SPEED=60

# Live map (all free). See "Live map and route search" in README.md for how to get each value.
# OpenRouteService key for road routes (free account at https://account.heigit.org; check the daily quota there).
# Without it Bookify uses the public OSRM server, then a straight line.
ORS_API_KEY=
# ORS profile: driving-car (default) or driving-hgv
ORS_PROFILE=driving-car
# API host (openrouteservice moved here in 2026; the old api.openrouteservice.org host was announced to shut down in Nov 2026).
ORS_BASE_URL=https://api.heigit.org
# Public OSRM fallback; set "off" to disable, or point at your own OSRM server.
OSRM_URL=
# Nominatim fallback for place names not in the built-in Bangladesh list; "off" to disable.
NOMINATIM_URL=
# Map tiles. Default is tile.openstreetmap.org (free, light use only). For heavier use, e.g. MapTiler:
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
# Simulated traffic jams on the live map: on (default) or off.
NEXT_PUBLIC_TRAFFIC_SIMULATION=on
